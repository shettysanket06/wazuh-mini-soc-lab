<!--
Wazuh Mini SOC Lab — project-specific local rules and tuning excerpt.
Reviewed from the lab's live local_rules.xml on 4 Nov 2026.
This is a mergeable snippet, not a drop-in replacement.

Caution: rule 61603 is overwritten with noalert="1". This changes alert
visibility for Sysmon Event ID 1. Review and validate before reuse.
-->

<group name="local,windows,sysmon,discovery,">

  <rule id="100100" level="3">
    <if_group>sysmon_event1</if_group>
    <field name="win.system.providerName">^Microsoft-Windows-Sysmon$</field>
    <field name="win.system.eventID">^1$</field>
    <field name="win.eventdata.image" type="pcre2">(?i)\\whoami\.exe$</field>
    <description>Windows discovery command executed: whoami.exe</description>
    <mitre>
      <id>T1033</id>
    </mitre>
    <group>sysmon_event1,windows_discovery,</group>
  </rule>

  <rule id="100101" level="3">
    <if_group>sysmon_event1</if_group>
    <field name="win.system.providerName">^Microsoft-Windows-Sysmon$</field>
    <field name="win.system.eventID">^1$</field>
    <field name="win.eventdata.image" type="pcre2">(?i)\\ipconfig\.exe$</field>
    <description>Windows discovery command executed: ipconfig.exe</description>
    <mitre>
      <id>T1016</id>
    </mitre>
    <group>sysmon_event1,windows_discovery,</group>
  </rule>

  <rule id="100102" level="3">
    <if_group>sysmon_event1</if_group>
    <field name="win.system.providerName">^Microsoft-Windows-Sysmon$</field>
    <field name="win.system.eventID">^1$</field>
    <field name="win.eventdata.image" type="pcre2">(?i)\\systeminfo\.exe$</field>
    <description>Windows discovery command executed: systeminfo.exe</description>
    <mitre>
      <id>T1082</id>
    </mitre>
    <group>sysmon_event1,windows_discovery,</group>
  </rule>

</group>

<group name="windows,sysmon,">
  <rule id="61603" level="3" overwrite="yes" noalert="1">
    <if_sid>61600</if_sid>
    <field name="win.system.eventID">^1$</field>
    <description>Sysmon - Event 1: Process creation $(win.eventdata.description)</description>
    <options>no_full_log</options>
    <group>sysmon_event1,</group>
  </rule>
</group>

<group name="local,windows,sysmon,powershell,">
  <rule id="100103" level="3">
    <if_group>sysmon_eid1_detections</if_group>
    <field name="win.system.providerName">^Microsoft-Windows-Sysmon$</field>
    <field name="win.system.eventID">^1$</field>
    <field name="win.eventdata.image" type="pcre2">(?i)\\powershell\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">SOC_LAB_POWERSHELL_TEST_20261104</field>
    <description>Controlled PowerShell execution test marker observed</description>
    <mitre>
      <id>T1059.001</id>
    </mitre>
    <group>sysmon_event1,powershell_execution,lab_test,</group>
  </rule>
</group>
